        "jsCode": "// Pick today's topic automatically\nconst topics = [\n  \"AI kya hai simple Urdu mein\",\n  \"ChatGPT kaise use karein\",\n  \"AI aur Machine Learning farq\",\n  \"Python install karna sikho\",\n  \"Google Colab free mein use karo\",\n  \"Groq API free kaise milti hai\",\n  \"AI agent kya hota hai\",\n  \"LangChain kya hai\",\n  \"Free AI tools Pakistan mein\",\n  \"AI se kya kaam kar sakte hain\",\n  \"Python basics part 1\",\n  \"Python basics part 2\",\n  \"CrewAI kya hai tutorial\",\n  \"Multi agent system banana\",\n  \"AI se data analysis karo\",\n  \"CSV file AI se analyze karo\",\n  \"AI se Excel report banao\",\n  \"Voice AI agent banana\",\n  \"RAG system banana\",\n  \"YouTube automation agent banana\",\n  \"AI freelancing Pakistan mein\",\n  \"AI se CV banana\",\n  \"AI business ideas 2027\",\n  \"Online paise AI se kamao\",\n  \"Google internship AI se pao\"\n];\n\n// Get day number automatically\nconst today = new Date();\nconst startOfYear = new Date(today.getFullYear(), 0, 0);\nconst dayOfYear = Math.floor((today - startOfYear) / 86400000);\nconst topicIndex = dayOfYear % topics.length;\n\nreturn [{\n  json: {\n    topic: topics[topicIndex],\n    day_number: dayOfYear,\n    date: today.toDateString()\n  }\n}];"
